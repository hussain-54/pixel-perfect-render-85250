# Supabase — copy to `.env` and fill in your project values.
# This is a Vite app, so client env vars must use the VITE_ prefix
# (not NEXT_PUBLIC_).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only (never VITE_*). Required for Admin → Accounts invite/create.
# Set in the host environment / secrets manager — never commit the real key.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional public origin for invite / password-reset redirect links:
# APP_ORIGIN=https://your-production-host.example

# Demo auth is development-only (`vite dev`). Production builds always
# disable demo authentication — demo accounts never ship live.

# Optional shared secret for external cron hitting task automation
# (portalRunTaskAutomation). Server also runs an in-process 5-minute sweep.
# TASK_AUTOMATION_CRON_SECRET=