# Supabase — copy to `.env` and fill in your project values.
# This is a Vite app, so client env vars must use the VITE_ prefix
# (not NEXT_PUBLIC_).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only (never VITE_*). Required for Admin → Settings → User & Account Management.
# Set in Vercel → Project → Settings → Environment Variables for Production
# (and Preview if needed), then Redeploy. Never commit the real key.
# Preferred name:
# SUPABASE_SERVICE_ROLE_KEY=
# Also accepted (alias used by some hosts/docs):
# SUPABASE_SECRET_KEY=
# Public origin for Auth recovery / password-reset redirect links.
# Production should be the canonical domain (matches SITE_ORIGIN):
# APP_ORIGIN=https://globalroots.pk
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://globalroots.pk
#   Redirect URLs (allow-list): https://globalroots.pk/reset-password
#     (+ https://globalroots.pk/change-password if used as redirect)
# Never put SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY in VITE_* vars.

# Demo auth is development-only (`vite dev`). Production builds always
# disable demo authentication — demo accounts never ship live.

# Optional shared secret for external cron hitting task automation
# (portalRunTaskAutomation). Server also runs an in-process 5-minute sweep.
# TASK_AUTOMATION_CRON_SECRET=